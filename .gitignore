# 本地智能体工作区数据（会话记忆/日志，切勿提交）
.workbuddy/

# 运行期产生的隐私与登录态（切勿提交）
.bridge-profile/
.printer-webview-profile/
.live-webview-profile/
.scene-webview-profile/
.capture-compat/
.bridge-room
.live-room
desktop-bridge.log
avatar-cache.json
ws-samples/
# 控制台设置与本机操作日志由后端在运行期落盘，属于本机用户数据
data/settings.json
# SQLite 是运行时唯一数据源；data/packs/*.json 与 data/media/index.json 保留为
# 入库的分发 / 备份格式，改动后可用 --db-export 重新导出。
data/printcast.db
data/printcast.db-wal
data/printcast.db-shm
data/audit.jsonl
data/audit.jsonl.tmp-*
data/*.tmp-*
.output-test/

# 虚拟环境（用户本地创建，绝不入库）
.venv/
venv/
env/

# 测试产物
__pycache__/
*.pyc
.pytest_cache/
tests-tmp/

# 打包 / editable install 产物
build/
dist/
*.egg-info/
*.egg
.eggs/

# 大体积运行时二进制（由 scripts/vendor-assets.sh 从上游还原）
# three.module.js（1.3MB）是渲染层唯一的硬依赖，体积可接受，直接入库，避免首跑必须联网。
assets/*.wav
assets/*.png
assets/generated/*.png
assets/generated/original-icons/*.png
docs/screenshots/*.png
docs/screenshots/*.jpg
docs/*.jpg
tiktok-cover.png
youtube-cover.png
/studio/node_modules/
# web/studio-dist/ 是有意入库的：产物仅约 96 KB，可让 clone 后 /studio/ 开箱即用。
# 改了 studio/ 源码后必须重跑 bash scripts/build-studio.sh 并把新产物一并提交。
